# dependencies & builds
node_modules/
dist/
*.tsbuildinfo
.vite/

# environment & secrets (only the *.example files are committed)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
*.pem
*.key

# raw database dumps/backups (may contain password hashes and emails) — keep these out of git
*.sql
!server/migrations/*.sql
*.sql.gz
*.dump
deploy/
backups/

# logs, screenshots, OS/editor files
*.log
npm-debug.log*
*.png
!docs/**/*.png
.DS_Store
.idea/
.vscode/
test-results/
playwright-report/
