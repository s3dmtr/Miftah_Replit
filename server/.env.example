# PostgreSQL connection string
DATABASE_URL=postgres://miftah:miftah@localhost:5432/miftah
# Secret used to sign JWT access tokens (use a long random value in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000
# Comma-separated list of allowed browser origins for CORS (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Password given to every seeded demo account
SEED_PASSWORD=miftah123
# AI agent: without OPENAI_API_KEY the agent uses the built-in Arabic/English parser (still searching the database).
# With it, OpenAI only extracts preferences; listings and ranking always come from PostgreSQL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Placeholders: still simulated
GOOGLE_MAPS_API_KEY=
RIYADH_PORTAL_API_KEY=

# Lets the frontend role switcher sign in as seeded demo users without a password. Set false in production.
ALLOW_DEMO_LOGIN=true
